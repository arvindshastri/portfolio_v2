---
/** A long-form page's header: the title, a lead, then the facts. No eyebrow above the title. */
interface Props {
  title: string;
  lead: string;
  facts?: { label: string; value: string }[];
}
const { title, lead, facts } = Astro.props;
---

<header class="hero">
  <h1>{title}</h1>
  <p class="lead">{lead}</p>
  {facts && (
    <dl class="meta">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  )}
</header>
