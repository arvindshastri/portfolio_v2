---
interface Props {
  /** [value, label] pairs, e.g. ['3,000+', 'commuters reached'] */
  items: [string, string][];
}
const { items } = Astro.props;
---

<div class="stats" data-n={items.length}>
  {items.map(([value, label]) => (
    <div>
      <b>{value}</b>
      <span>{label}</span>
    </div>
  ))}
</div>
